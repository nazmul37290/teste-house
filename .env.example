# Copy to .env (never commit .env). Production values live in Dokploy environment variables.

# --- Core ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.example.com   (production only)

# --- Database / Redis (matches docker/compose.dev.yml) ---
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379

# --- Auth: generate each with: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-2
ENCRYPTION_KEY=change-me-change-me-change-me-change-me-3

# --- Mail: mailgun or smtp (dev uses Mailpit on localhost:1025) ---
MAIL_PROVIDER=smtp
MAIL_FROM="Shop <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=

# --- Steadfast (add when Phase 8 starts) ---
# STEADFAST_BASE_URL=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_WEBHOOK_TOKEN=

# --- UddoktaPay (add when Phase 7 starts) ---
# UDDOKTAPAY_BASE_URL=
# UDDOKTAPAY_API_KEY=
# UDDOKTAPAY_WEBHOOK_SECRET=

# --- Files ---
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_URL=http://localhost:4000/media

# --- Frontend (also copy these into apps/web/.env.local) ---
REVALIDATE_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Seed (development only): creates the Super Admin when both are set ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-123456
