# Copy to .env (never commit .env). Production values live in Dokploy environment variables.

# --- Core ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.example.com   (production only)

# --- Database / Redis (matches docker/compose.dev.yml) ---
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379
# Integration tests only (pnpm test:integration); the database name must end with _test
DATABASE_URL_TEST=postgresql://shop:shop@localhost:5432/shop_test
REDIS_URL_TEST=redis://localhost:6379/1

# --- Auth (Better Auth, see docs/auth.md). Generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=change-me-to-a-random-value-of-32-plus-chars
# Public origin the browser uses (web app; it rewrites /api/v1/* to the API)
BETTER_AUTH_URL=http://localhost:3000

# --- Mail: mailgun or smtp (dev uses Mailpit on localhost:1025) ---
MAIL_PROVIDER=smtp
MAIL_FROM="Shop <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=

# --- Steadfast (add when Phase 8 starts) ---
# STEADFAST_BASE_URL=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_WEBHOOK_TOKEN=

# --- UddoktaPay (online payment; leave empty to offer Cash on Delivery only) ---
# Your UddoktaPay installation, e.g. https://pay.yourshop.com.bd. Development: the public sandbox
# https://sandbox.uddoktapay.com with the test key published in UddoktaPay's API docs.
# The same key authenticates UddoktaPay's webhook; there is no separate webhook secret.
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=

# --- Files ---
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_URL=http://localhost:4000/media

# --- Frontend (also copy these into apps/web/.env.local) ---
# Shared by the API worker and the web app (same value in apps/web/.env.local); 16+ chars: openssl rand -hex 24
REVALIDATE_SECRET=change-me-to-a-random-value
# Where the worker reaches the web app to refresh storefront pages (Dokploy: http://<web service>:3000)
WEB_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# --- Seed (development only; skipped when NODE_ENV=production): creates the Super Admin through Better Auth. Password: at least 12 characters ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-123456

# --- Production one-off (node dist/create-super-admin.js); set only in the container shell, never in Dokploy env ---
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=

# --- Error tracking (optional; leave empty to turn off) ---
# From your Sentry project (free tier). Same DSN for api and worker; environment e.g. production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
