# Copy to apps/web/.env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Target of the /api/v1/* rewrite and server-side fetches (internal network URL in Dokploy)
API_INTERNAL_URL=http://localhost:4000
# Same value as REVALIDATE_SECRET in the root .env (16+ chars)
REVALIDATE_SECRET=change-me-to-a-random-value
