# Build context: repository root. Used by the api and the worker (same image, different command).
FROM node:22-alpine AS base
# pnpm at the version in package.json "packageManager", fetched once into this cached layer.
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo

FROM base AS build
# 1. Package manifests only. The install below is the slow step; Docker reuses this layer until a
#    manifest or the lockfile changes, so a code-only change skips it.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
# Only what the API needs: the api, its workspace dependencies (@shop/shared) and the root (Prisma
# CLI and dotenv for prisma.config.ts). The web app's packages (Next.js, React...) are skipped.
RUN pnpm install --frozen-lockfile --filter "@shop/api..." --filter ecommerce
# 2. The code (.dockerignore keeps node_modules, dist and .git out, so the install above stays).
COPY . .
# generate needs a DATABASE_URL value only to load the config; no connection is made
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm exec prisma generate
RUN pnpm --filter @shop/api build
RUN pnpm --filter @shop/api deploy --legacy --prod /out

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/prisma ./prisma
COPY --from=build /repo/prisma.config.ts ./prisma.config.ts
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh && mkdir -p /data/uploads && chown -R node:node /app /data
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD wget -qO- http://127.0.0.1:4000/health || exit 1
ENTRYPOINT ["api-entrypoint.sh"]
CMD ["node", "dist/server.js"]
